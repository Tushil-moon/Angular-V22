generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  DELETED
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  GITHUB
}

enum OtpPurpose {
  LOGIN
  PHONE_VERIFICATION
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuditAction {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  REFRESH_ROTATED
  TOKEN_REVOKED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  PHONE_OTP_SENT
  PHONE_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  ROLE_ASSIGNED
  ROLE_REMOVED
  ACCOUNT_LOCKED
  LOGIN_ATTEMPT
  PASSWORD_REUSED
  FORCE_PASSWORD_CHANGE
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  INACTIVE
}

enum LeadSource {
  WEBSITE
  REFERRAL
  CAMPAIGN
  COLD_CALL
  TRADE_SHOW
  PARTNER
  IMPORT
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  NURTURING
  CONVERTED
  LOST
}

enum LeadRating {
  HOT
  WARM
  COLD
}

enum LeadHistoryAction {
  CREATED
  STAGE_CHANGED
  ASSIGNED
  SCORED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
  FOLLOW_UP_SET
  NOTE_ADDED
}

enum ContactEmailType {
  WORK
  PERSONAL
  OTHER
}

enum ContactPhoneType {
  MOBILE
  WORK
  HOME
  FAX
  OTHER
}

enum ContactAddressType {
  BILLING
  SHIPPING
  HOME
  WORK
  OTHER
}

enum SocialPlatform {
  LINKEDIN
  TWITTER
  FACEBOOK
  INSTAGRAM
  GITHUB
  WEBSITE
  OTHER
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum DealHistoryAction {
  CREATED
  STAGE_CHANGED
  VALUE_CHANGED
  ASSIGNED
  WON
  LOST
  REOPENED
  NOTE_ADDED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ActivityPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityHistoryAction {
  CREATED
  UPDATED
  ASSIGNED
  COMPLETED
  REOPENED
  CANCELLED
  REMINDER_SET
  RECURRENCE_UPDATED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id                  String      @id @default(uuid())
  email               String?     @unique
  phone               String?     @unique
  passwordHash        String?
  emailVerified       Boolean     @default(false)
  phoneVerified       Boolean     @default(false)
  status              UserStatus  @default(ACTIVE)
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  mustChangePassword  Boolean     @default(false)
  passwordChangedAt   DateTime?
  twoFactorEnabled    Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  accounts           Account[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  roles              UserRole[]
  otpCodes           OtpCode[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]
  passwordHistory    PasswordHistory[]
  loginAttempts      LoginAttempt[]
  twoFactorSecret    TwoFactorSecret?
  ownedContacts      Contact[]  @relation("ContactOwner")
  ownedDeals         Deal[]     @relation("DealOwner")
  ownedCompanies     Company[]  @relation("CompanyOwner")
  activitiesCreated  Activity[]        @relation("ActivityCreator")
  activitiesAssigned Activity[]        @relation("ActivityAssignee")
  activityHistory    ActivityHistory[]
  calendarAvailabilityRules CalendarAvailabilityRule[]
  calendarEventAttendees    CalendarEventAttendee[]
  calendarHistory           CalendarEventHistory[]
  savedViews         SavedView[]
  organizationMembers OrganizationMember[]
  organizationInvites OrganizationInvite[] @relation("OrganizationInvites")
  managedOrgUnits     OrgUnit[]            @relation("OrgUnitManager")
  orgUnitMemberships  OrgUnitMember[]
  managedEmployees    OrganizationMember[] @relation("EmployeeReportsTo")
  ownedQuotes        Quote[]    @relation("QuoteOwner")
  forecastPeriods    ForecastPeriod[]
  calendarEvents     CalendarEvent[]
  reports            Report[]
  dashboardLayouts   DashboardLayout[]
  caseComments       CaseComment[]
  assignedCases      Case[]     @relation("CaseAssignee")
  knowledgeArticles  KnowledgeArticle[] @relation("KnowledgeAuthor")
  stickyNotes        StickyNote[]
  leadHistory        LeadHistory[]
  dealHistory        DealHistory[]
  quoteHistory       QuoteHistory[]
  caseHistory        CaseHistory[]
  campaignHistory    CampaignHistory[]
  ownedCampaigns     Campaign[]        @relation("CampaignOwner")
  ownedWorkflows     Workflow[]        @relation("WorkflowOwner")

  @@index([status])
  @@map("users")
}

model Account {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  deviceId      String
  deviceName    String?
  userAgent     String?
  ipAddress     String?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  lastActiveAt  DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@unique([userId, deviceId])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  sessionId         String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model OtpCode {
  id          String     @id @default(uuid())
  userId      String?
  phone       String
  codeHash    String
  purpose     OtpPurpose
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose])
  @@index([userId])
  @@map("otp_codes")
}

model VerificationToken {
  id          String                @id @default(uuid())
  userId      String
  tokenHash   String                @unique
  type        VerificationTokenType
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model LoginAttempt {
  id            String   @id @default(uuid())
  userId        String?
  identifier    String
  success       Boolean
  ipAddress     String?
  userAgent     String?
  failureReason String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([identifier, createdAt])
  @@map("login_attempts")
}

model TwoFactorSecret {
  id              String    @id @default(uuid())
  userId          String    @unique
  secretEncrypted String
  backupCodesHash String[]
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  action      String
  subject     String
  description String?
  createdAt   DateTime         @default(now())

  roles RolePermission[]

  @@unique([action, subject])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

enum SavedViewEntity {
  CONTACTS
  DEALS
  COMPANIES
  ACTIVITIES
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgUnitType {
  BRANCH
  DEPARTMENT
  TEAM
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  currency  String   @default("USD") @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  invites  OrganizationInvite[]
  contacts Contact[]
  deals    Deal[]
  companies Company[]
  activities Activity[]
  activityHistory ActivityHistory[]
  calendarEvents CalendarEvent[]
  calendarAvailabilityRules CalendarAvailabilityRule[]
  calendarEventAttendees CalendarEventAttendee[]
  calendarHistory CalendarEventHistory[]
  tags     Tag[]
  savedViews SavedView[]
  quotes              Quote[]
  products            Product[]
  quoteHistory        QuoteHistory[]
  forecastPeriods     ForecastPeriod[]
  leadScoreRules      LeadScoreRule[]
  campaigns           Campaign[]
  campaignHistory     CampaignHistory[]
  emailTemplates      EmailTemplate[]
  emailSequences      EmailSequence[]
  workflowRuns        WorkflowRun[]
  forms               Form[]
  cases               Case[]
  caseHistory         CaseHistory[]
  knowledgeArticles   KnowledgeArticle[]
  slaPolicies         SlaPolicy[]
  queues              Queue[]
  reports             Report[]
  reportRuns          ReportRun[]
  dashboardLayouts    DashboardLayout[]
  workflows           Workflow[]
  webhooks            Webhook[]
  aiFeatureFlags      AiFeatureFlag[]
  aiInsights          AiInsight[]
  apiKeys             ApiKey[]
  customFieldDefinitions CustomFieldDefinition[]
  territories         Territory[]
  stickyNotes         StickyNote[]
  orgUnits            OrgUnit[]
  orgUnitMembers      OrgUnitMember[]
  leads               Lead[]
  leadHistory         LeadHistory[]
  pipelines           Pipeline[]
  dealHistory         DealHistory[]

  @@map("organizations")
}

model OrgUnit {
  id             String      @id @default(uuid())
  organizationId String
  parentId       String?
  type           OrgUnitType
  name           String
  code           String?
  description    String?
  managerUserId  String?
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       OrgUnit?      @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     OrgUnit[]     @relation("OrgUnitHierarchy")
  manager      User?         @relation("OrgUnitManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  members      OrgUnitMember[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@index([organizationId, type])
  @@index([organizationId, deletedAt])
  @@map("org_units")
}

model OrgUnitMember {
  id             String   @id @default(uuid())
  organizationId String
  orgUnitId      String
  userId         String
  isPrimary      Boolean  @default(false)
  title          String?
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUnit      OrgUnit      @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgUnitId, userId])
  @@index([organizationId, userId])
  @@map("org_unit_members")
}

model OrganizationMember {
  organizationId String
  userId         String
  role           OrganizationMemberRole @default(MEMBER)
  managerUserId  String?
  jobTitle       String?
  employeeCode   String?
  joinedAt       DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager      User?        @relation("EmployeeReportsTo", fields: [managerUserId], references: [id], onDelete: SetNull)

  @@id([organizationId, userId])
  @@index([userId])
  @@index([organizationId, managerUserId])
  @@unique([organizationId, employeeCode])
  @@map("organization_members")
}

model OrganizationInvite {
  id             String                 @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationMemberRole @default(MEMBER)
  tokenHash      String                 @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("OrganizationInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invites")
}

model Company {
  id             String    @id @default(uuid())
  organizationId String
  parentCompanyId String?  @map("parent_company_id")
  name           String
  domain    String?
  industry  String?
  size      String?
  website   String?
  address   String?
  employeeCount    Int?     @map("employee_count")
  annualRevenue    Decimal? @map("annual_revenue") @db.Decimal(15, 2)
  revenueCurrency  String   @default("USD") @map("revenue_currency") @db.VarChar(3)
  ownershipPercent Decimal? @map("ownership_percent") @db.Decimal(5, 2)
  ownerId   String?   @map("owner_id")
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner         User?             @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentCompany Company?          @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  subsidiaries  Company[]         @relation("CompanyHierarchy")
  locations     CompanyLocation[]
  contacts      Contact[]
  cases         Case[]
  deals         Deal[]
  activities    Activity[]
  calendarEvents CalendarEvent[]
  quotes         Quote[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([parentCompanyId])
  @@index([name])
  @@index([domain])
  @@map("companies")
}

model CompanyLocation {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  label          String?
  line1          String
  line2          String?
  city           String?
  state          String?
  postalCode     String?  @map("postal_code")
  country        String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  isHeadquarters Boolean  @default(false) @map("is_headquarters")
  createdAt      DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_locations")
}

model Tag {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts ContactTag[]
  deals    DealTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model ContactTag {
  contactId String @map("contact_id")
  tagId     String @map("tag_id")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model DealTag {
  dealId String @map("deal_id")
  tagId  String @map("tag_id")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
  @@map("deal_tags")
}

model SavedView {
  id             String          @id @default(uuid())
  organizationId String
  userId         String          @map("user_id")
  entityType     SavedViewEntity @map("entity_type")
  name           String
  filters        Json            @default("{}")
  sort           Json?
  columns        Json?
  isDefault      Boolean         @default(false) @map("is_default")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, entityType])
  @@map("saved_views")
}

model Contact {
  id             String        @id @default(uuid())
  organizationId String
  firstName String
  lastName  String
  email     String?
  phone     String?
  company   String?
  companyId String? @map("company_id")
  jobTitle  String?
  status    ContactStatus @default(LEAD)
  leadSource   LeadSource? @map("lead_source")
  sourceDetail String?     @map("source_detail")
  ownerId   String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  owner      User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyRef Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals      Deal[]
  activities Activity[]
  tags       ContactTag[]
  emails       ContactEmail[]
  phones       ContactPhone[]
  addresses    ContactAddress[]
  socialLinks  ContactSocialLink[]
  campaignMembers CampaignMember[]
  calendarEvents  CalendarEvent[]
  quotes          Quote[]
  cases           Case[]
  formSubmissions FormSubmission[]
  lead            Lead?

  @@index([organizationId])
  @@index([ownerId])
  @@index([companyId])
  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([organizationId, firstName, lastName])
  @@map("contacts")
}

model ContactEmail {
  id        String            @id @default(uuid())
  contactId String            @map("contact_id")
  email     String
  type      ContactEmailType  @default(WORK)
  isPrimary Boolean           @default(false) @map("is_primary")
  createdAt DateTime          @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, email])
  @@index([email])
  @@index([contactId])
  @@map("contact_emails")
}

model ContactPhone {
  id        String           @id @default(uuid())
  contactId String           @map("contact_id")
  phone     String
  type      ContactPhoneType @default(MOBILE)
  isPrimary Boolean          @default(false) @map("is_primary")
  createdAt DateTime         @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, phone])
  @@index([phone])
  @@index([contactId])
  @@map("contact_phones")
}

model ContactAddress {
  id         String             @id @default(uuid())
  contactId  String             @map("contact_id")
  label      String?
  line1      String
  line2      String?
  city       String?
  state      String?
  postalCode String?            @map("postal_code")
  country    String?
  type       ContactAddressType @default(WORK)
  isPrimary  Boolean            @default(false) @map("is_primary")
  createdAt  DateTime           @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("contact_addresses")
}

model ContactSocialLink {
  id        String         @id @default(uuid())
  contactId String         @map("contact_id")
  platform  SocialPlatform
  url       String
  createdAt DateTime       @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, platform, url])
  @@index([contactId])
  @@map("contact_social_links")
}

model Pipeline {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@index([organizationId])
  @@map("pipelines")
}

model PipelineStage {
  id         String    @id @default(uuid())
  pipelineId String    @map("pipeline_id")
  name       String
  stageKey   DealStage @map("stage_key")
  probability Int      @default(0)
  sortOrder  Int       @default(0) @map("sort_order")
  isClosed   Boolean   @default(false) @map("is_closed")
  isWon      Boolean   @default(false) @map("is_won")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, stageKey])
  @@index([pipelineId, sortOrder])
  @@map("pipeline_stages")
}

model Deal {
  id                String    @id @default(uuid())
  organizationId    String
  title             String
  value             Decimal   @db.Decimal(15, 2)
  currency          String    @default("USD")
  stage             DealStage @default(LEAD)
  pipelineId        String?   @map("pipeline_id")
  pipelineStageId   String?   @map("pipeline_stage_id")
  contactId         String?
  companyId         String?   @map("company_id")
  leadId            String?   @map("lead_id")
  ownerId           String?
  probability       Int?
  expectedCloseDate DateTime?
  description       String?
  winReason         String?   @map("win_reason")
  lossReason        String?   @map("loss_reason")
  competitor        String?
  closedAt          DateTime? @map("closed_at")
  sortOrder         Int       @default(0) @map("sort_order")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner          User?          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline       Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStage  PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  activities     Activity[]
  tags           DealTag[]
  quotes         Quote[]
  calendarEvents CalendarEvent[]
  history        DealHistory[]

