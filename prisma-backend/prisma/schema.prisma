generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums — Auth
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  DELETED
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  GITHUB
}

enum OtpPurpose {
  LOGIN
  PHONE_VERIFICATION
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuditAction {
  // Auth / RBAC
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  REFRESH_ROTATED
  TOKEN_REVOKED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  PHONE_OTP_SENT
  PHONE_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  ROLE_ASSIGNED
  ROLE_REMOVED
  ACCOUNT_LOCKED
  LOGIN_ATTEMPT
  PASSWORD_REUSED
  FORCE_PASSWORD_CHANGE
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  ROLE_UPDATED
  PERMISSION_UPDATED
  // Catalog
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  PRODUCT_PUBLISHED
  PRODUCT_ARCHIVED
  PRODUCT_IMAGE_ADDED
  PRODUCT_IMAGE_UPDATED
  PRODUCT_IMAGE_DELETED
  PRODUCT_IMAGES_REORDERED
  VARIANT_CREATED
  VARIANT_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  BRAND_CREATED
  COLLECTION_UPDATED
  // Inventory
  INVENTORY_ADJUSTED
  INVENTORY_TRANSFERRED
  INVENTORY_RESERVED
  INVENTORY_RELEASED
  PURCHASE_ORDER_CREATED
  PURCHASE_ORDER_RECEIVED
  // Customers
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  // Orders
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CANCELLED
  ORDER_FULFILLED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_COMPLETED
  // Payments / refunds
  PAYMENT_AUTHORIZED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  REFUND_CREATED
  REFUND_COMPLETED
  REFUND_REJECTED
  // Marketing
  PROMOTION_CREATED
  COUPON_CREATED
  GIFT_CARD_ISSUED
  STORE_CREDIT_ADJUSTED
  // Content / CX
  REVIEW_MODERATED
  CMS_UPDATED
  MEDIA_UPLOADED
  SETTINGS_UPDATED
  REPORT_REQUESTED
}

// =============================================================================
// Enums — Store / Catalog / Inventory / Sales
// =============================================================================

enum StoreStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum ProductType {
  SIMPLE
  VARIABLE
  DIGITAL
  PHYSICAL
  SUBSCRIPTION
  BUNDLE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductVisibility {
  VISIBLE
  HIDDEN
  CATALOG_ONLY
  SEARCH_ONLY
}

enum CollectionType {
  MANUAL
  RULE_BASED
}

enum InventoryMovementType {
  ADJUSTMENT
  RECEIPT
  TRANSFER_IN
  TRANSFER_OUT
  RESERVE
  RELEASE
  FULFILL
  RETURN
  DAMAGE
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
  EXPIRED
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AddressType {
  BILLING
  SHIPPING
  BOTH
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PARTIAL
  FULFILLED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum PaymentProviderType {
  STRIPE
  PAYPAL
  RAZORPAY
  MANUAL
  COD
  STORE_CREDIT
  GIFT_CARD
  OTHER
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum GiftCardStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  DEPLETED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ReportJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// =============================================================================
// Auth & RBAC (retained)
// =============================================================================

model User {
  id                  String     @id @default(uuid())
  email               String?    @unique
  phone               String?    @unique
  firstName           String?
  lastName            String?
  passwordHash        String?
  emailVerified       Boolean    @default(false)
  phoneVerified       Boolean    @default(false)
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  mustChangePassword  Boolean    @default(false)
  passwordChangedAt   DateTime?
  twoFactorEnabled    Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  accounts             Account[]
  sessions             Session[]
  refreshTokens        RefreshToken[]
  roles                UserRole[]
  otpCodes             OtpCode[]
  verificationTokens   VerificationToken[]
  auditLogs            AuditLog[]
  passwordHistory      PasswordHistory[]
  loginAttempts        LoginAttempt[]
  twoFactorSecret      TwoFactorSecret?
  storeUsers           StoreUser[]
  customerNotes        CustomerNote[]        @relation("CustomerNoteAuthor")
  orderNotes           OrderNote[]           @relation("OrderNoteAuthor")
  inventoryMovements   InventoryMovement[]   @relation("InventoryMovementActor")
  stockAdjustments     StockAdjustment[]     @relation("StockAdjustmentActor")
  reportJobs           ReportJob[]
  notifications        Notification[]        @relation("UserNotifications")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  deviceId     String
  deviceName   String?
  userAgent    String?
  ipAddress    String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  sessionId         String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String     @id @default(uuid())
  userId     String?
  phone      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose])
  @@index([userId])
  @@map("otp_codes")
}

model VerificationToken {
  id         String                @id @default(uuid())
  userId     String
  tokenHash  String                @unique
  type       VerificationTokenType
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model LoginAttempt {
  id            String   @id @default(uuid())
  userId        String?
  identifier    String
  success       Boolean
  ipAddress     String?
  userAgent     String?
  failureReason String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([identifier, createdAt])
  @@map("login_attempts")
}

model TwoFactorSecret {
  id              String    @id @default(uuid())
  userId          String    @unique
  secretEncrypted String
  backupCodesHash String[]
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String
  subject     String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([action, subject])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Store / Settings / Tax
// =============================================================================

model Store {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  code        String?     @unique
  status      StoreStatus @default(ACTIVE)
  timezone    String      @default("UTC")
  currencyCode String     @default("USD") @db.VarChar(3)
  locale      String      @default("en-US")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  settings            StoreSettings?
  users               StoreUser[]
  currencies          StoreCurrency[]
  taxRegions          TaxRegion[]
  taxClasses          TaxClass[]
  brands              Brand[]
  categories          Category[]
  collections         Collection[]
  tags                Tag[]
  products            Product[]
  warehouses          Warehouse[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  customers           Customer[]
  customerGroups      CustomerGroup[]
  carts               Cart[]
  orders              Order[]
  paymentProviders    PaymentProvider[]
  shippingZones       ShippingZone[]
  promotions          Promotion[]
  coupons             Coupon[]
  giftCards           GiftCard[]
  mediaAssets         MediaAsset[]
  cmsPages            CmsPage[]
  cmsBanners          CmsBanner[]
  cmsMenus            CmsMenu[]
  reviews             Review[]
  wishlists           Wishlist[]
  notificationTemplates NotificationTemplate[]
  notifications       Notification[]
  reportJobs          ReportJob[]
  idempotencyKeys     IdempotencyKey[]

  @@index([status])
  @@index([deletedAt])
  @@map("stores")
}

model StoreSettings {
  id                   String   @id @default(uuid())
  storeId              String   @unique
  legalName            String?
  supportEmail         String?
  supportPhone         String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  countryCode          String?  @db.VarChar(2)
  weightUnit           String   @default("kg")
  dimensionUnit        String   @default("cm")
  taxInclusivePricing  Boolean  @default(false)
  lowStockThreshold    Int      @default(5)
  orderNumberPrefix    String   @default("ORD")
  allowGuestCheckout   Boolean  @default(true)
  inventoryTracking    Boolean  @default(true)
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model StoreUser {
  id        String   @id @default(uuid())
  storeId   String
  userId    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_users")
}

model Currency {
  id            String   @id @default(uuid())
  code          String   @unique @db.VarChar(3)
  name          String
  symbol        String
  decimalPlaces Int      @default(2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stores StoreCurrency[]

  @@map("currencies")
}

model StoreCurrency {
  id           String   @id @default(uuid())
  storeId      String
  currencyCode String
  exchangeRate Decimal  @default(1) @db.Decimal(18, 8)
  isDefault    Boolean  @default(false)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@unique([storeId, currencyCode])
  @@map("store_currencies")
}

model TaxRegion {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  countryCode String   @db.VarChar(2)
  stateCode   String?
  postalCodes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  store Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates TaxRate[]

  @@index([storeId, countryCode])
  @@map("tax_regions")
}

model TaxClass {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates    TaxRate[]
  products Product[]
  variants ProductVariant[]

  @@unique([storeId, code])
  @@map("tax_classes")
}

model TaxRate {
  id          String   @id @default(uuid())
  storeId     String
  taxRegionId String
  taxClassId  String
  name        String
  rate        Decimal  @db.Decimal(8, 4)
  priority    Int      @default(0)
  isCompound  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  taxRegion TaxRegion @relation(fields: [taxRegionId], references: [id], onDelete: Cascade)
  taxClass  TaxClass  @relation(fields: [taxClassId], references: [id], onDelete: Cascade)

  @@unique([taxRegionId, taxClassId])
  @@index([storeId])
  @@map("tax_rates")
}

// =============================================================================
// Catalog
// =============================================================================

model Brand {
  id              String   @id @default(uuid())
  storeId         String
  name            String
  slug            String
  description     String?
  website         String?
  logoMediaId     String?
  metaTitle       String?
  metaDescription String?
  status          ProductStatus @default(PUBLISHED)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([deletedAt])
  @@map("brands")
}

model Category {
  id              String   @id @default(uuid())
  storeId         String
  parentId        String?
  name            String
  slug            String
  description     String?
  imageMediaId    String?
  bannerMediaId   String?
  metaTitle       String?
  metaDescription String?
  status          ProductStatus @default(PUBLISHED)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products ProductCategory[]

  @@unique([storeId, slug])
  @@index([storeId, parentId])
  @@index([storeId, status])
  @@index([deletedAt])
  @@map("categories")
}

model Collection {
  id              String         @id @default(uuid())
  storeId         String
  name            String
  slug            String
  description     String?
  type            CollectionType @default(MANUAL)
  rules           Json?
  imageMediaId    String?
  metaTitle       String?
  metaDescription String?
  featured        Boolean        @default(false)
  status          ProductStatus  @default(PUBLISHED)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  store    Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products ProductCollection[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([deletedAt])
  @@map("collections")
}

model Tag {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  store    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products ProductTag[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("tags")
}

model Product {
  id                String            @id @default(uuid())
  storeId           String
  brandId           String?
  taxClassId        String?
  name              String
  slug              String
  description       String?
  shortDescription  String?
  type              ProductType       @default(SIMPLE)
  status            ProductStatus     @default(DRAFT)
  visibility        ProductVisibility @default(VISIBLE)
  featured          Boolean           @default(false)
  metaTitle         String?
  metaDescription   String?
  metaKeywords      String?
  hsnCode           String?
  weight            Decimal?          @db.Decimal(12, 4)
  length            Decimal?          @db.Decimal(12, 4)
  width             Decimal?          @db.Decimal(12, 4)
  height            Decimal?          @db.Decimal(12, 4)
  minQuantity       Int?
  maxQuantity       Int?
  lowStockThreshold Int?
  sortOrder         Int               @default(0)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand        Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  taxClass     TaxClass?           @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  options      ProductOption[]
  variants     ProductVariant[]
  images       ProductImage[]
  attributes   ProductAttribute[]
  categories   ProductCategory[]
  collections  ProductCollection[]
  tags         ProductTag[]
  relatedFrom  ProductRelation[]   @relation("ProductRelationFrom")
  relatedTo    ProductRelation[]   @relation("ProductRelationTo")
  reviews      Review[]
  wishlistItems WishlistItem[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, brandId])
  @@index([deletedAt])
  @@index([name])
  @@map("products")
}

model ProductOption {
  id        String   @id @default(uuid())
  productId String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id        String   @id @default(uuid())
  optionId  String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  option  ProductOption              @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id              String        @id @default(uuid())
  storeId         String
  productId       String
  taxClassId      String?
  sku             String
  barcode         String?
  title           String?
  price           Decimal       @db.Decimal(15, 4)
  compareAtPrice  Decimal?      @db.Decimal(15, 4)
  costPrice       Decimal?      @db.Decimal(15, 4)
  weight          Decimal?      @db.Decimal(12, 4)
  length          Decimal?      @db.Decimal(12, 4)
  width           Decimal?      @db.Decimal(12, 4)
  height          Decimal?      @db.Decimal(12, 4)
  status          ProductStatus @default(PUBLISHED)
  position        Int           @default(0)
  trackInventory  Boolean       @default(true)
  allowBackorder  Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  product           Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxClass          TaxClass?                   @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  optionValues      ProductVariantOptionValue[]
  images            ProductImage[]
  inventoryItems    InventoryItem[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]
  wishlistItems     WishlistItem[]

  @@unique([storeId, sku])
  @@index([productId])
  @@index([storeId, status])
  @@index([barcode])
  @@index([deletedAt])
  @@map("product_variants")
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("product_variant_option_values")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  variantId String?
  mediaId   String?
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([variantId])
  @@map("product_images")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  name      String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

model ProductCategory {
  productId  String
  categoryId String
  position   Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model ProductRelation {
  id              String @id @default(uuid())
  productId       String
  relatedProductId String
  relationType    String
  position        Int    @default(0)

  product        Product @relation("ProductRelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelationTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, relationType])
  @@index([productId])
  @@map("product_relations")
}

// =============================================================================
// Inventory
// =============================================================================

model Warehouse {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  code      String
  isDefault Boolean  @default(false)
  addressLine1 String?
  addressLine2 String?
  city      String?
  state     String?
  postalCode String?
  countryCode String? @db.VarChar(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  locations       WarehouseLocation[]
  inventoryItems  InventoryItem[]
  movements       InventoryMovement[]
  reservations    InventoryReservation[]
  transfersFrom   StockTransfer[]     @relation("TransferFromWarehouse")
  transfersTo     StockTransfer[]     @relation("TransferToWarehouse")
  adjustments     StockAdjustment[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([deletedAt])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String   @id @default(uuid())
  warehouseId String
  code        String
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

model InventoryItem {
  id                String   @id @default(uuid())
  storeId           String
  warehouseId       String
  locationId        String?
  variantId         String
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  quantityAvailable Int      @default(0)
  reorderPoint      Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location     WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  variant      ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@unique([warehouseId, variantId])
  @@index([storeId, variantId])
  @@index([variantId])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String                @id @default(uuid())
  storeId         String
  inventoryItemId String
  warehouseId     String
  variantId       String
  type            InventoryMovementType
  quantity        Int
  quantityBefore  Int
  quantityAfter   Int
  referenceType   String?
  referenceId     String?
  note            String?
  createdById     String?
  createdAt       DateTime              @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("InventoryMovementActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model InventoryReservation {
  id              String            @id @default(uuid())
  storeId         String
  inventoryItemId String
  warehouseId     String
  variantId       String
  quantity        Int
  status          ReservationStatus @default(ACTIVE)
  referenceType   String
  referenceId     String
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  releasedAt      DateTime?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([referenceType, referenceId])
  @@index([inventoryItemId, status])
  @@map("inventory_reservations")
}

model StockTransfer {
  id               String              @id @default(uuid())
  storeId          String
  transferNumber   String
  fromWarehouseId  String
  toWarehouseId    String
  status           StockTransferStatus @default(DRAFT)
  note             String?
  shippedAt        DateTime?
  receivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  fromWarehouse Warehouse          @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse          @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  items         StockTransferItem[]

  @@unique([storeId, transferNumber])
  @@index([storeId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String @id @default(uuid())
  transferId String
  variantId  String
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("stock_transfer_items")
}

model StockAdjustment {
  id             String   @id @default(uuid())
  storeId        String
  warehouseId    String
  adjustmentNumber String
  reason         String?
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  warehouse Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("StockAdjustmentActor", fields: [createdById], references: [id], onDelete: SetNull)
  items     StockAdjustmentItem[]

  @@unique([storeId, adjustmentNumber])
  @@index([storeId, createdAt])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String @id @default(uuid())
  adjustmentId String
  variantId    String
  quantityDelta Int
  reason       String?

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
  @@map("stock_adjustment_items")
}

model Supplier {
  id           String   @id @default(uuid())
  storeId      String
  name         String
  code         String?
  email        String?
  phone        String?
  website      String?
  contactName  String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  countryCode  String?  @db.VarChar(2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([storeId, code])
  @@index([storeId, name])
  @@index([deletedAt])
  @@map("suppliers")
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  storeId       String
  warehouseId   String
  supplierId    String
  poNumber      String
  status        PurchaseOrderStatus @default(DRAFT)
  currencyCode  String              @default("USD") @db.VarChar(3)
  subtotal      Decimal             @default(0) @db.Decimal(15, 4)
  taxTotal      Decimal             @default(0) @db.Decimal(15, 4)
  shippingTotal Decimal             @default(0) @db.Decimal(15, 4)
  grandTotal    Decimal             @default(0) @db.Decimal(15, 4)
  orderedAt     DateTime?
  expectedAt    DateTime?
  receivedAt    DateTime?
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([storeId, poNumber])
  @@index([storeId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  variantId       String
  skuSnapshot     String
  nameSnapshot    String
  quantityOrdered Int
  quantityReceived Int    @default(0)
  unitCost        Decimal @db.Decimal(15, 4)
  taxAmount       Decimal @default(0) @db.Decimal(15, 4)
  lineTotal       Decimal @db.Decimal(15, 4)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  storeId         String
  purchaseOrderId String?
  warehouseId     String
  receiptNumber   String
  status          GoodsReceiptStatus @default(DRAFT)
  receivedAt      DateTime?
  note            String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@unique([storeId, receiptNumber])
  @@index([storeId, status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String @id @default(uuid())
  goodsReceiptId String
  variantId      String
  quantity       Int
  unitCost       Decimal? @db.Decimal(15, 4)

  goodsReceipt GoodsReceipt   @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

// =============================================================================
// Customers
// =============================================================================

model Customer {
  id               String         @id @default(uuid())
  storeId          String
  userId           String?
  email            String?
  phone            String?
  firstName        String?
  lastName         String?
  status           CustomerStatus @default(ACTIVE)
  acceptsMarketing Boolean        @default(false)
  notes            String?
  totalOrders      Int            @default(0)
  totalSpent       Decimal        @default(0) @db.Decimal(15, 4)
  averageOrderValue Decimal       @default(0) @db.Decimal(15, 4)
  lifetimeValue    Decimal        @default(0) @db.Decimal(15, 4)
  lastOrderAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses     CustomerAddress[]
  groups        CustomerGroupMember[]
  tags          CustomerTag[]
  customerNotes CustomerNote[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  wishlists     Wishlist[]
  storeCredits  StoreCreditAccount[]
  giftCards     GiftCard[]

  @@unique([storeId, email])
  @@index([storeId, status])
  @@index([storeId, phone])
  @@index([deletedAt])
  @@map("customers")
}

model CustomerAddress {
  id           String      @id @default(uuid())
  customerId   String
  type         AddressType @default(BOTH)
  label        String?
  firstName    String?
  lastName     String?
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  countryCode  String      @db.VarChar(2)
  phone        String?
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerGroup {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  store     Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  members   CustomerGroupMember[]
  promotions PromotionCustomerGroup[]

  @@unique([storeId, code])
  @@map("customer_groups")
}

model CustomerGroupMember {
  customerId String
  groupId    String
  assignedAt DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  group    CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([customerId, groupId])
  @@map("customer_group_members")
}

model CustomerTag {
  id         String   @id @default(uuid())
  customerId String
  name       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, name])
  @@map("customer_tags")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  authorId   String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation("CustomerNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

// =============================================================================
// Sales — Cart / Order / Fulfillment / Shipment
// =============================================================================

model Cart {
  id              String     @id @default(uuid())
  storeId         String
  customerId      String?
  sessionKey      String?
  status          CartStatus @default(ACTIVE)
  currencyCode    String     @default("USD") @db.VarChar(3)
  subtotal        Decimal    @default(0) @db.Decimal(15, 4)
  discountTotal   Decimal    @default(0) @db.Decimal(15, 4)
  taxTotal        Decimal    @default(0) @db.Decimal(15, 4)
  shippingTotal   Decimal    @default(0) @db.Decimal(15, 4)
  grandTotal      Decimal    @default(0) @db.Decimal(15, 4)
  couponCode      String?
  abandonedAt     DateTime?
  recoveredAt     DateTime?
  convertedOrderId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  expiresAt       DateTime?

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([storeId, status])
  @@index([customerId])
  @@index([sessionKey])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(15, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id                String            @id @default(uuid())
  storeId           String
  customerId        String?
  orderNumber       String
  status            OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  currencyCode      String            @default("USD") @db.VarChar(3)
  subtotal          Decimal           @db.Decimal(15, 4)
  discountTotal     Decimal           @default(0) @db.Decimal(15, 4)
  taxTotal          Decimal           @default(0) @db.Decimal(15, 4)
  shippingTotal     Decimal           @default(0) @db.Decimal(15, 4)
  paymentFeeTotal   Decimal           @default(0) @db.Decimal(15, 4)
  giftCardTotal     Decimal           @default(0) @db.Decimal(15, 4)
  storeCreditTotal  Decimal           @default(0) @db.Decimal(15, 4)
  grandTotal        Decimal           @db.Decimal(15, 4)
  amountPaid        Decimal           @default(0) @db.Decimal(15, 4)
  amountRefunded    Decimal           @default(0) @db.Decimal(15, 4)
  couponCode        String?
  customerEmail     String?
  customerPhone     String?
  note              String?
  placedAt          DateTime?
  cancelledAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  addresses       OrderAddress[]
  statusHistory   OrderStatusHistory[]
  notes           OrderNote[]
  discounts       OrderDiscount[]
  taxes           OrderTax[]
  shippingLines   OrderShipping[]
  fulfillments    Fulfillment[]
  shipments       Shipment[]
  payments        PaymentTransaction[]
  refunds         Refund[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
  @@index([paymentStatus])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  variantId       String?
  productId       String?
  // Immutable purchase-time snapshots
  productName     String
  variantTitle    String?
  sku             String
  barcode         String?
  quantity        Int
  unitPrice       Decimal  @db.Decimal(15, 4)
  compareAtPrice  Decimal? @db.Decimal(15, 4)
  discountAmount  Decimal  @default(0) @db.Decimal(15, 4)
  taxAmount       Decimal  @default(0) @db.Decimal(15, 4)
  lineTotal       Decimal  @db.Decimal(15, 4)
  taxClassCode    String?
  weight          Decimal? @db.Decimal(12, 4)
  metadata        Json?
  createdAt       DateTime @default(now())

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  fulfillmentItems  FulfillmentItem[]
  shipmentItems     ShipmentItem[]
  refundItems       RefundItem[]

  @@index([orderId])
  @@index([variantId])
  @@index([sku])
  @@map("order_items")
}

model OrderAddress {
  id           String      @id @default(uuid())
  orderId      String
  type         AddressType
  firstName    String?
  lastName     String?
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  countryCode  String      @db.VarChar(2)
  phone        String?
  createdAt    DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
  @@map("order_addresses")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdById String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderNote {
  id        String   @id @default(uuid())
  orderId   String
  authorId  String?
  body      String
  isInternal Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User? @relation("OrderNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_notes")
}

model OrderDiscount {
  id             String  @id @default(uuid())
  orderId        String
  code           String?
  description    String?
  amount         Decimal @db.Decimal(15, 4)
  promotionId    String?
  couponId       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_discounts")
}

model OrderTax {
  id       String  @id @default(uuid())
  orderId  String
  name     String
  rate     Decimal @db.Decimal(8, 4)
  amount   Decimal @db.Decimal(15, 4)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_taxes")
}

model OrderShipping {
  id             String  @id @default(uuid())
  orderId        String
  methodCode     String?
  methodName     String
  amount         Decimal @db.Decimal(15, 4)
  taxAmount      Decimal @default(0) @db.Decimal(15, 4)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_shippings")
}

model Fulfillment {
  id             String            @id @default(uuid())
  orderId        String
  storeId        String
  warehouseId    String?
  status         FulfillmentStatus @default(PENDING)
  fulfilledAt    DateTime?
  note           String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  order Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items FulfillmentItem[]

  @@index([orderId])
  @@index([storeId, status])
  @@map("fulfillments")
}

model FulfillmentItem {
  id            String @id @default(uuid())
  fulfillmentId String
  orderItemId   String
  quantity      Int

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId])
  @@map("fulfillment_items")
}

model Shipment {
  id               String         @id @default(uuid())
  orderId          String
  storeId          String
  fulfillmentId    String?
  status           ShipmentStatus @default(PENDING)
  carrier          String?
  service          String?
  trackingNumber   String?
  trackingUrl      String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ShipmentItem[]

  @@index([orderId])
  @@index([storeId, status])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentItem {
  id          String @id @default(uuid())
  shipmentId  String
  orderItemId String
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_items")
}

// =============================================================================
// Payments
// =============================================================================

model PaymentProvider {
  id        String              @id @default(uuid())
  storeId   String
  type      PaymentProviderType
  name      String
  enabled   Boolean             @default(true)
  config    Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([storeId, type])
  @@map("payment_providers")
}

model PaymentTransaction {
  id                String        @id @default(uuid())
  storeId           String
  orderId           String
  providerId        String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(15, 4)
  currencyCode      String        @db.VarChar(3)
  providerReference String?
  idempotencyKey    String?
  rawResponse       Json?
  authorizedAt      DateTime?
  capturedAt        DateTime?
  failedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order    Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider PaymentProvider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  refunds  Refund[]
  webhooks PaymentWebhookEvent[]

  @@unique([storeId, idempotencyKey])
  @@index([orderId])
  @@index([storeId, status])
  @@index([providerReference])
  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id              String   @id @default(uuid())
  storeId         String
  providerType    PaymentProviderType
  eventId         String
  eventType       String
  paymentId       String?
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  payment PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([storeId, providerType, eventId])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

model Refund {
  id          String       @id @default(uuid())
  storeId     String
  orderId     String
  paymentId   String?
  status      RefundStatus @default(REQUESTED)
  amount      Decimal      @db.Decimal(15, 4)
  currencyCode String      @db.VarChar(3)
  reason      String?
  note        String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order   Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items   RefundItem[]

  @@index([orderId])
  @@index([storeId, status])
  @@map("refunds")
}

model RefundItem {
  id          String  @id @default(uuid())
  refundId    String
  orderItemId String
  quantity    Int
  amount      Decimal @db.Decimal(15, 4)
  restock     Boolean @default(false)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@map("refund_items")
}

// =============================================================================
// Shipping
// =============================================================================

model ShippingZone {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  countries   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  store   Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  methods ShippingMethod[]

  @@index([storeId])
  @@map("shipping_zones")
}

model ShippingMethod {
  id            String   @id @default(uuid())
  storeId       String
  zoneId        String
  name          String
  code          String
  description   String?
  enabled       Boolean  @default(true)
  minDeliveryDays Int?
  maxDeliveryDays Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  zone  ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rates ShippingRate[]

  @@unique([storeId, code])
  @@index([zoneId])
  @@map("shipping_methods")
}

model ShippingRate {
  id               String   @id @default(uuid())
  methodId         String
  name             String?
  minWeight        Decimal? @db.Decimal(12, 4)
  maxWeight        Decimal? @db.Decimal(12, 4)
  minOrderSubtotal Decimal? @db.Decimal(15, 4)
  maxOrderSubtotal Decimal? @db.Decimal(15, 4)
  price            Decimal  @db.Decimal(15, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  method ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@index([methodId])
  @@map("shipping_rates")
}

// =============================================================================
// Promotions / Coupons / Gift Cards / Store Credit
// =============================================================================

model Promotion {
  id              String        @id @default(uuid())
  storeId         String
  name            String
  code            String?
  type            PromotionType
  value           Decimal       @db.Decimal(15, 4)
  startsAt        DateTime?
  endsAt          DateTime?
  usageLimit      Int?
  usageCount      Int           @default(0)
  perCustomerLimit Int?
  minSubtotal     Decimal?      @db.Decimal(15, 4)
  stackable       Boolean       @default(false)
  enabled         Boolean       @default(true)
  rules           Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  store          Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  coupons        Coupon[]
  customerGroups PromotionCustomerGroup[]

  @@unique([storeId, code])
  @@index([storeId, enabled])
  @@map("promotions")
}

model PromotionCustomerGroup {
  promotionId String
  groupId     String

  promotion Promotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  group     CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([promotionId, groupId])
  @@map("promotion_customer_groups")
}

model Coupon {
  id               String       @id @default(uuid())
  storeId          String
  promotionId      String?
  code             String
  status           CouponStatus @default(ACTIVE)
  usageLimit       Int?
  usageCount       Int          @default(0)
  perCustomerLimit Int?
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@unique([storeId, code])
  @@index([storeId, status])
  @@map("coupons")
}

model GiftCard {
  id            String         @id @default(uuid())
  storeId       String
  customerId    String?
  code          String
  initialBalance Decimal       @db.Decimal(15, 4)
  balance       Decimal        @db.Decimal(15, 4)
  currencyCode  String         @db.VarChar(3)
  status        GiftCardStatus @default(ACTIVE)
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  store        Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  transactions GiftCardTransaction[]

  @@unique([storeId, code])
  @@index([storeId, status])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id          String   @id @default(uuid())
  giftCardId  String
  amount      Decimal  @db.Decimal(15, 4)
  balanceAfter Decimal @db.Decimal(15, 4)
  type        String
  referenceType String?
  referenceId String?
  note        String?
  createdAt   DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId, createdAt])
  @@map("gift_card_transactions")
}

model StoreCreditAccount {
  id           String   @id @default(uuid())
  storeId      String
  customerId   String
  balance      Decimal  @default(0) @db.Decimal(15, 4)
  currencyCode String   @db.VarChar(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions StoreCreditTransaction[]

  @@unique([storeId, customerId, currencyCode])
  @@map("store_credit_accounts")
}

model StoreCreditTransaction {
  id          String   @id @default(uuid())
  accountId   String
  amount      Decimal  @db.Decimal(15, 4)
  balanceAfter Decimal @db.Decimal(15, 4)
  type        String
  referenceType String?
  referenceId String?
  note        String?
  createdAt   DateTime @default(now())

  account StoreCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("store_credit_transactions")
}

// =============================================================================
// Media / CMS
// =============================================================================

model MediaAsset {
  id           String   @id @default(uuid())
  storeId      String
  filename     String
  originalName String?
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  url          String
  storageKey   String
  altText      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, storageKey])
  @@index([storeId, mimeType])
  @@index([deletedAt])
  @@map("media_assets")
}

model CmsPage {
  id              String        @id @default(uuid())
  storeId         String
  title           String
  slug            String
  body            String?
  status          CmsPageStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@map("cms_pages")
}

model CmsBanner {
  id         String    @id @default(uuid())
  storeId    String
  title      String
  subtitle   String?
  imageUrl   String?
  linkUrl    String?
  position   String?
  sortOrder  Int       @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, enabled])
  @@map("cms_banners")
}

model CmsMenu {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  handle    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items CmsMenuItem[]

  @@unique([storeId, handle])
  @@map("cms_menus")
}

model CmsMenuItem {
  id        String   @id @default(uuid())
  menuId    String
  parentId  String?
  title     String
  url       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu     CmsMenu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   CmsMenuItem?  @relation("CmsMenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children CmsMenuItem[] @relation("CmsMenuTree")

  @@index([menuId, position])
  @@map("cms_menu_items")
}

// =============================================================================
// Reviews / Wishlist
// =============================================================================

model Review {
  id              String       @id @default(uuid())
  storeId         String
  productId       String
  customerId      String?
  rating          Int
  title           String?
  body            String?
  status          ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean   @default(false)
  adminReply      String?
  adminRepliedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  media    ReviewMedia[]

  @@index([storeId, status])
  @@index([productId, status])
  @@index([customerId])
  @@map("reviews")
}

model ReviewMedia {
  id        String   @id @default(uuid())
  reviewId  String
  url       String
  mimeType  String?
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_media")
}

model Wishlist {
  id         String   @id @default(uuid())
  storeId    String
  customerId String
  name       String   @default("Default")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@unique([storeId, customerId, name])
  @@map("wishlists")
}

model WishlistItem {
  id              String   @id @default(uuid())
  wishlistId      String
  productId       String
  variantId       String?
  priceAtAdd      Decimal? @db.Decimal(15, 4)
  notifyOnRestock Boolean  @default(false)
  createdAt       DateTime @default(now())

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId, variantId])
  @@map("wishlist_items")
}

// =============================================================================
// Notifications / Reports / Idempotency
// =============================================================================

model NotificationTemplate {
  id        String              @id @default(uuid())
  storeId   String
  code      String
  name      String
  channel   NotificationChannel
  subject   String?
  body      String
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code, channel])
  @@map("notification_templates")
}

model Notification {
  id          String              @id @default(uuid())
  storeId     String?
  userId      String?
  customerId  String?
  channel     NotificationChannel @default(IN_APP)
  status      NotificationStatus  @default(PENDING)
  title       String
  body        String
  data        Json?
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user  User?  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([storeId, createdAt])
  @@map("notifications")
}

model ReportJob {
  id           String          @id @default(uuid())
  storeId      String
  requestedById String?
  type         String
  status       ReportJobStatus @default(QUEUED)
  params       Json?
  resultUrl    String?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requestedBy User? @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([requestedById])
  @@map("report_jobs")
}

model IdempotencyKey {
  id           String            @id @default(uuid())
  storeId      String?
  key          String
  method       String
  path         String
  requestHash  String?
  status       IdempotencyStatus @default(PROCESSING)
  responseCode Int?
  responseBody Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  expiresAt    DateTime?

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
