}

model SlaPolicy {
  id                 String       @id @default(uuid())
  organizationId     String
  name               String
  description        String?
  priority           CasePriority @default(MEDIUM)
  firstResponseHours Int
  resolutionHours    Int
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cases        Case[]
  queues       Queue[]

  @@index([organizationId])
  @@index([active])
  @@map("sla_policies")
}

model Queue {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  slaPolicyId    String?  @map("sla_policy_id")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slaPolicy    SlaPolicy?   @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  cases        Case[]

  @@index([organizationId])
  @@index([slaPolicyId])
  @@map("queues")
}

model Report {
  id             String          @id @default(uuid())
  organizationId String
  userId         String
  name           String
  description    String?
  entityType     String
  chartType      ReportChartType @default(TABLE)
  isShared       Boolean         @default(false)
  config         Json            @default("{}")
  lastRunAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs         ReportRun[]

  @@index([organizationId])
  @@index([userId])
  @@index([entityType])
  @@map("reports")
}

enum ReportChartType {
  TABLE
  BAR
  LINE
  PIE
  KPI
}

enum ReportRunStatus {
  PENDING
  COMPLETED
  FAILED
}

model ReportRun {
  id             String          @id @default(uuid())
  organizationId String
  reportId       String
  status         ReportRunStatus @default(PENDING)
  rowCount       Int             @default(0)
  result         Json?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report         Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([reportId])
  @@index([status])
  @@map("report_runs")
}

model DashboardLayout {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  name           String
  description    String?
  isDefault      Boolean  @default(false)
  isShared       Boolean  @default(false)
  widgets        Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("dashboard_layouts")
}

model Workflow {
  id             String    @id @default(uuid())
  organizationId String
  ownerId        String?
  name           String
  description    String?
  trigger        String
  active         Boolean   @default(true)
  definition     Json      @default("{}")
  runCount       Int       @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?         @relation("WorkflowOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  runs         WorkflowRun[]

  @@index([organizationId])
  @@index([organizationId, trigger])
  @@index([active])
  @@map("workflows")
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum WorkflowStepRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model WorkflowRun {
  id             String            @id @default(uuid())
  organizationId String
  workflowId     String
  triggerEvent   String
  status         WorkflowRunStatus @default(PENDING)
  context        Json              @default("{}")
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps        WorkflowStepRun[]

  @@index([organizationId])
  @@index([workflowId])
  @@index([status])
  @@map("workflow_runs")
}

model WorkflowStepRun {
  id           String                @id @default(uuid())
  runId        String
  stepOrder    Int
  actionType   String
  status       WorkflowStepRunStatus @default(PENDING)
  input        Json                  @default("{}")
  output       Json?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime              @default(now())

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("workflow_step_runs")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model Webhook {
  id             String   @id @default(uuid())
  organizationId String
  url            String
  events         String[]
  secret         String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookId      String
  event          String
  payload        Json                  @default("{}")
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?
  errorMessage   String?
  lastAttemptAt  DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@map("webhook_deliveries")
}

model AiFeatureFlag {
  id             String  @id @default(uuid())
  organizationId String
  feature        String
  enabled        Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, feature])
  @@index([organizationId])
  @@map("ai_feature_flags")
}

model AiInsight {
  id             String   @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  type           String
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("ai_insights")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([prefix])
  @@map("api_keys")
}

model CustomFieldDefinition {
  id             String   @id @default(uuid())
  organizationId String
  entityType     String
  key            String
  label          String
  fieldType      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, key])
  @@index([organizationId])
  @@map("custom_field_definitions")
}

model Territory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  rules          Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("territories")
}

model StickyNote {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  title          String?
  content        String   @default("")
  color          String   @default("#fef08a")
  isPinned       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([isPinned])
  @@map("sticky_notes")
}
